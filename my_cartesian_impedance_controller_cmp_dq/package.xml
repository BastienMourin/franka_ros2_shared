<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_cartesian_impedance_controller_cmp_dq</name>
  <version>0.0.0</version>
  <description>Cartesian impedance controller using a dual-quaternion screw error, with a feedforward wrench input.</description>
  <maintainer email="bastien.mourin@sigma-clermont.fr">Bastien Mourin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>realtime_tools</depend>
  <depend>ament_index_cpp</depend>
  <depend>dq_operations</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
